ENVIRONMENT=production
HIPAA_MODE=true
ALLOW_DUMMY_LOGIN=false
SECRET_KEY=<key-vault-secret-or-container-app-secret>
CONTROL_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<server>.postgres.database.azure.com:5432/nexora_control?ssl=require
DEFAULT_TENANT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<server>.postgres.database.azure.com:5432/nexora_tenant?ssl=require
TENANT_DATABASE_URL_TEMPLATE=
TENANT_DATABASE_SCHEMA_TEMPLATE=
REDIS_URL=rediss://:<access-key>@<redis-host>:10000/0
CORS_ORIGINS=["https://<static-web-app-host>"]
AUDIT_LOG_PATH=/tmp/audit.log
AZURE_STORAGE_CONNECTION_STRING=<key-vault-secret-or-container-app-secret>
BACKGROUND_QUEUE_URL=<service-bus-connection-string>
