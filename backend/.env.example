# ─────────────────────────────────────────────────────────────────────────────
# Nexora Platform — backend environment template
#
# Copy to `.env` (gitignored) for local dev, or set these as Container App
# secrets / Key Vault references in production. NEVER commit a real `.env`.
# Values shown are placeholders; replace every <...>.
#
# In production the app fails to boot if SECRET_KEY, FIELD_ENCRYPTION_KEY, or
# CONTROL_DATABASE_URL are missing/placeholder (see app.core.config).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | test | production
HIPAA_MODE=true
ALLOW_DUMMY_LOGIN=false                 # MUST be false in production

# 32+ random bytes. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<change-me-32+-byte-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_IDLE_MINUTES=30
REFRESH_TOKEN_MAX_LIFETIME_MINUTES=720

# Comma-separated Fernet keys (writers use the first). Generate one:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<fernet-key>

# ── Databases (use ?ssl=require in production) ───────────────────────────────
CONTROL_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/nexora_control
DEFAULT_TENANT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/nexora_tenant
TENANT_DATABASE_URL_TEMPLATE=
TENANT_DATABASE_SCHEMA_TEMPLATE=

# ── Redis (recommended in prod: backs rate limiting, lockout, token revocation)
REDIS_URL=rediss://:<access-key>@<redis-host>:6380/0

# ── CORS / hosts ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://<your-frontend-host>"]
ALLOWED_TENANT_HOSTS={}
CANONICAL_HOST_DOMAIN=

# ── Auth / MFA / rate limiting ───────────────────────────────────────────────
REQUIRE_ADMIN_MFA=true
REQUIRE_PHI_MFA=false                   # set true once all PHI users are MFA-enrolled
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5
PHI_RATE_LIMIT_PER_MINUTE=30

# ── Transactional email ───────────────────────────────────────────────────────
# Drives the marketing contact form. Provider precedence: SendGrid → SMTP →
# no-op. Leave both blank in dev (messages are logged, not sent); in production
# an unconfigured provider makes the contact endpoint return 503.
# Preferred: SendGrid v3 Web API. EMAIL_FROM must be a SendGrid-verified sender.
SENDGRID_API_KEY=<key-vault-secret>
# Alternative/fallback: SMTP relay (also works against smtp.sendgrid.net with
# SMTP_USERNAME=apikey and SMTP_PASSWORD=<sendgrid-api-key>).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=<key-vault-secret>
SMTP_USE_TLS=true
EMAIL_FROM=                             # verified sender; falls back to SMTP_USERNAME when blank
CONTACT_INBOX_EMAIL=contact@nexoralab.co

# ── Audit logging ────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=logs/audit.log
PHI_AUDIT_LOG_PATH=logs/phi_audit.log   # point at a WORM/immutable mount in prod
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Azure AD / Entra SSO (optional) ──────────────────────────────────────────
AZURE_AUTH_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=<key-vault-secret>
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
AZURE_AUTH_SCOPES=openid profile email

# ── AI / data plane (all auth via DefaultAzureCredential — no keys) ──────────
ANTHROPIC_API_KEY=<anthropic-key>
CLAUDE_MODEL=claude-sonnet-4-6
AZURE_OPENAI_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_COSMOS_ENDPOINT=
AZURE_EVENT_HUB_NAMESPACE=
AZURE_STORAGE_ACCOUNT_NAME=

# ── Storage backends ─────────────────────────────────────────────────────────
MEMBER360_STORAGE_BACKEND=local
MEMBER360_STORAGE_ROOT=data/member360
BACKGROUND_QUEUE_URL=<service-bus-connection-string>
