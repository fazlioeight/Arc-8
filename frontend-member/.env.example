# API base URL of the Nexora backend.
REACT_APP_API_BASE=http://localhost:8000

# Tenant key for this deployment. If unset, it is inferred from the host
# subdomain (e.g. https://prominencehealth.portal.example.com -> prominencehealth).
REACT_APP_TENANT_KEY=prominencehealth

# Optional white-label overrides (otherwise a neutral default theme is used).
REACT_APP_BRAND_NAME=Member Portal
REACT_APP_BRAND_PRIMARY=#0a66c2
REACT_APP_BRAND_LOGO_URL=
